<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    .card-custom {
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      padding: 2rem;
      background-color: #fff;
    }

    .img-preview {
      width: 100%;
      max-width: 400px;
      border-radius: 8px;
      object-fit: cover;
    }

    .label-title {
      font-weight: bold;
      color: #092966;
    }

    .info-text {
      color: #555;
    }
  </style>
</head>
<body class="bg-light">

  <div class="container my-5">
    <h1 class="text-center mb-4 text-primary fw-bold"><%= title %></h1>

    <div class="card card-custom mx-auto" style="max-width: 800px;">
      <div class="row g-4">
        <div class="col-md-6 text-center">
          <img src="/<%= foto.ruta.replace('public/', '') %>" alt="<%= foto.titulo %>" class="img-preview">
        </div>
        <div class="col-md-6">
          <p><span class="label-title">ID:</span> <span class="info-text"><%= foto.id %></span></p>
          <p><span class="label-title">Título:</span> <span class="info-text"><%= foto.titulo %></span></p>
          <p><span class="label-title">Descripción:</span> <span class="info-text"><%= foto.descripcion %></span></p>
          <p><span class="label-title">Calificación:</span> 
            <span class="badge bg-success fs-6"><%= foto.calificacion %></span>
          </p>
          <p><span class="label-title">Fecha de creación:</span> 
            <span class="info-text"><%= new Date(foto.createdAt).toLocaleDateString() %></span>
          </p>
          <p><span class="label-title">Etiquetas:</span><br>
            <% if (foto.etiqueta && foto.etiqueta.length > 0) { %>
              <% foto.etiqueta.forEach(et => { %>
                <span class="badge bg-secondary me-1"><%= et.texto %></span>
              <% }) %>
            <% } else { %>
              <span class="text-muted">Sin etiquetas</span>
            <% } %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
